  "lines": [
    {"speaker": "narrator", "say": "What if a *meteor* hit your city tonight?",
     "shot": {"set": {"type": "sky", "time": "night"}, "cast": [{"id": "hero", "x": 0.5, "pose": "point", "expr": "shocked", "scale": 0.9}],
              "fx": [{"type": "meteor", "x": 300, "y": 900, "hitAt": 9, "size": 0.6}], "camera": {"zoom": 1.0, "push": 0.08}}},
    {"speaker": "narrator", "say": "Eleven fifty eight. Jay is gaming.",
     "shot": {"set": {"type": "room", "time": "night"}, "cast": [{"id": "hero", "x": 0.42, "pose": "idle", "expr": "happy"}, {"id": "bit", "x": 0.8, "expr": "neutral", "scale": 1.0, "depth": 0.2}],
              "ui": {"type": "clock", "text": "23:58"}}},
    {"speaker": "bit", "say": "Jay. Why is the sky *orange*?",
     "shot": {"set": {"type": "room", "time": "dusk", "damage": 0}, "cast": [{"id": "bit", "x": 0.5, "expr": "think", "scale": 1.6, "enter": "pop"}], "camera": {"zoom": 1.15, "y": 0.6}}},
    {"speaker": "hero", "say": "Probably a sunset.",
     "shot": {"set": {"type": "room", "time": "dusk"}, "cast": [{"id": "hero", "x": 0.5, "pose": "shrug", "expr": "smug", "scale": 1.6}], "camera": {"zoom": 1.1, "y": 0.6}}},
    {"speaker": "bit", "say": "At *midnight*?",
     "shot": {"set": {"type": "room", "time": "dusk"}, "cast": [{"id": "bit", "x": 0.5, "icon": "?", "scale": 1.7}], "camera": {"zoom": 1.2, "y": 0.6}, "transition": "whip"}},
    {"speaker": "narrator", "say": "Then every phone screams at once.",
     "shot": {"set": {"type": "room", "time": "night"}, "cast": [{"id": "hero", "x": 0.5, "pose": "phone", "expr": "shocked", "scale": 1.5}],
              "ui": {"type": "notify", "app": "Emergency Alert", "title": "Object incoming. Seek shelter now.", "color": "#E0312B"}, "fx": [{"type": "alarm"}]}},
    {"speaker": "narrator", "say": "Impact in *ten minutes*.",
     "shot": {"set": {"type": "burst", "color": "#E0312B"}, "cast": [], "ui": {"type": "card", "text": "10:00", "sub": "UNTIL IMPACT"}, "transition": "flash"}},
    {"speaker": "hero", "say": "Bit! Where do we *go*?",
     "shot": {"set": {"type": "room", "time": "night"}, "cast": [{"id": "hero", "x": 0.36, "pose": "panic", "expr": "scared"}, {"id": "bit", "x": 0.78, "expr": "shocked", "scale": 1.1}], "fx": [{"type": "alarm"}]}},
    {"speaker": "bit", "say": "Statistically? *Very* far away.",
     "shot": {"set": {"type": "room", "time": "night"}, "cast": [{"id": "bit", "x": 0.5, "expr": "smug", "scale": 1.7}], "camera": {"zoom": 1.15, "y": 0.6}}},
    {"speaker": "narrator", "say": "Outside, the streets are *chaos*.",
     "shot": {"set": {"type": "street", "time": "night"}, "cast": [{"id": "friend", "x": 1.1, "moveTo": -0.2, "pose": "run", "expr": "scared", "facing": -1}, {"id": "kid", "x": -0.1, "moveTo": 1.2, "pose": "run", "expr": "scared", "depth": 0.4}, {"id": "boss", "x": 0.2, "moveTo": 0.9, "pose": "run", "expr": "shocked", "depth": 0.7}], "fx": [{"type": "alarm"}], "transition": "whip"}},
    {"speaker": "boss", "say": "It's the size of a *stadium*. Please stay calm.",
     "shot": {"set": {"type": "news", "headline": "METEOR INCOMING"}, "cast": [{"id": "boss", "x": 0.5, "expr": "scared", "scale": 1.25}], "camera": {"zoom": 1.0}}},
    {"speaker": "narrator", "say": "Jay grabs the only thing that matters.",
     "shot": {"set": {"type": "room", "time": "night", "damage": 1}, "cast": [{"id": "hero", "x": 0.2, "moveTo": 0.75, "pose": "run", "expr": "angry"}], "fx": [{"type": "alarm"}]}},
    {"speaker": "hero", "say": "My *gaming chair*!",
     "shot": {"set": {"type": "burst", "color": "#2F6BFF"}, "cast": [{"id": "hero", "x": 0.5, "pose": "cheer", "expr": "grin", "scale": 1.5}], "fx": [{"type": "speedLines"}], "transition": "flash"}},
    {"speaker": "bit", "say": "Jay. *Look up.*",
     "shot": {"set": {"type": "sky", "time": "night"}, "cast": [{"id": "hero", "x": 0.35, "pose": "idle", "expr": "scared", "scale": 1.0}, {"id": "bit", "x": 0.68, "expr": "shocked", "scale": 0.8}],
              "fx": [{"type": "meteor", "x": 520, "y": 1000, "hitAt": 6, "size": 1.3}], "camera": {"push": 0.12}}},
    {"speaker": "narrator", "say": "*Three.* *Two.* *One.*", "pauseAfter": 0.4,
     "shot": {"set": {"type": "sky", "time": "night"}, "cast": [], "fx": [{"type": "meteor", "x": 560, "y": 1450, "hitAt": 1.6, "size": 1.6}, {"type": "impact", "x": 560, "y": 1450, "at": 1.6}]}},
    {"speaker": "narrator", "say": "When the dust settles, the meteor *opens*.",
     "shot": {"set": {"type": "wasteland"}, "cast": [{"id": "hero", "x": 0.3, "pose": "idle", "expr": "shocked", "depth": 0.3}, {"id": "bit", "x": 0.55, "expr": "shocked", "depth": 0.3, "scale": 0.9}],
              "fx": [{"type": "ufo", "x": 700, "beam": false}], "transition": "flash"}},
    {"speaker": "narrator", "say": "And something inside says... *hello*.",
     "shot": {"set": {"type": "wasteland"}, "cast": [{"id": "hero", "x": 0.3, "pose": "panic", "expr": "scared", "depth": 0.3}, {"id": "bit", "x": 0.55, "icon": "!", "depth": 0.3, "scale": 0.9}],
              "fx": [{"type": "ufo", "x": 700, "beam": true}, {"type": "vignette"}], "camera": {"push": 0.1}}},
    {"speaker": "narrator", "say": "Follow for part two.", "end": true}
  ]
}
