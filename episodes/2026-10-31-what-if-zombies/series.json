{
  "title": "What If a Zombie Apocalypse Started With One Notification?",
  "rubric": "what-if: disaster",
  "mood": "tension",
  "seed": 3100,
  "names": {"hero": "JAY", "bit": "BIT", "friend": "MIA", "soldier": "SOLDIER"},
  "finale": {"text": "SEASON 2?", "sub": "Follow to find out what was in the backup"},
  "parts": [
    {"title": "The Notification", "lines": [
      {"speaker": "narrator", "say": "What if a zombie apocalypse started with *one notification*?",
       "shot": {"set": {"type": "street", "time": "day"}, "cast": [{"id": "boss", "x": 0.2, "pose": "phone", "expr": "neutral", "depth": 0.5}, {"id": "friend", "x": 0.75, "pose": "phone", "expr": "happy", "depth": 0.35}, {"id": "kid", "x": 0.45, "pose": "phone", "expr": "grin", "scale": 1.45}],
                "ui": {"type": "notify", "app": "System", "title": "Update 7.0 is ready", "body": "Tap to install"}, "sfx": [{"type": "buzz", "at": 0.2}], "camera": {"push": 0.08}}},
      {"speaker": "narrator", "say": "Seven in the morning. Every phone buzzes *at once*.",
       "shot": {"set": {"type": "news", "headline": "GLOBAL PHONE UPDATE"}, "cast": [{"id": "boss", "x": 0.5, "pose": "phone", "expr": "happy", "scale": 1.25}], "sfx": [{"type": "buzz", "at": 0.1}, {"type": "buzz", "at": 0.9, "volume": 0.4}], "transition": "whip"}},
      {"speaker": "narrator", "say": "Everyone taps *install*. Everyone except Jay.",
       "shot": {"set": {"type": "room", "time": "day"}, "cast": [{"id": "hero", "x": 0.45, "pose": "idle", "expr": "sleepy", "scale": 1.5}, {"id": "bit", "x": 0.82, "expr": "neutral", "scale": 0.9, "depth": 0.3}], "sfx": [{"type": "pop", "at": 0.4}]}},
      {"speaker": "bit", "say": "Jay. Wake up. The neighbors are walking *weird*.",
       "shot": {"set": {"type": "room", "time": "day"}, "cast": [{"id": "bit", "x": 0.5, "expr": "think", "scale": 1.7, "enter": "pop"}], "camera": {"zoom": 1.1, "y": 0.6}, "sfx": [{"type": "pop"}]}},
      {"speaker": "hero", "say": "It's Monday. *Everyone* walks weird.",
       "shot": {"set": {"type": "room", "time": "day"}, "cast": [{"id": "hero", "x": 0.5, "pose": "facepalm", "expr": "sleepy", "scale": 1.7}], "camera": {"zoom": 1.1, "y": 0.6}}},
      {"speaker": "narrator", "say": "Outside, people stare at their screens and *stop blinking*.",
       "shot": {"set": {"type": "street", "time": "day"}, "cast": [{"id": "zombie", "x": 0.25, "pose": "phone", "expr": "neutral", "depth": 0.3}, {"id": "zombie2", "x": 0.7, "pose": "phone", "expr": "neutral", "depth": 0.1}, {"id": "friend", "x": 0.5, "pose": "phone", "expr": "neutral", "depth": 0.6}], "sfx": [{"type": "heartbeat"}], "camera": {"push": 0.1}}},
      {"speaker": "narrator", "say": "Their eyes go white. Their skin turns *green*.",
       "shot": {"set": {"type": "street", "time": "dusk"}, "cast": [{"id": "zombie", "x": 0.5, "pose": "zombie", "expr": "angry", "scale": 2.3}], "camera": {"zoom": 1.15, "y": 0.45}, "fx": [{"type": "vignette"}], "sfx": [{"type": "growl", "at": 0.2}], "transition": "flash"}},
      {"speaker": "narrator", "say": "Then Jay's phone starts *ringing*.",
       "shot": {"set": {"type": "room", "time": "day"}, "cast": [{"id": "hero", "x": 0.5, "pose": "phone", "expr": "shocked", "scale": 1.6}], "ui": {"type": "notify", "app": "Phone", "title": "Mom is calling...", "color": "#2DBE7E"}, "sfx": [{"type": "ring"}]}},
      {"speaker": "narrator", "say": "Every head on the street turns *toward his window*.",
       "shot": {"set": {"type": "street", "time": "dusk"}, "cast": [{"id": "zombie", "x": 0.15, "pose": "zombie", "depth": 0.7, "facing": -1}, {"id": "zombie2", "x": 0.35, "pose": "zombie", "depth": 0.5}, {"id": "zombie", "x": 0.6, "pose": "zombie", "depth": 0.3, "facing": -1}, {"id": "zombie2", "x": 0.85, "pose": "zombie", "depth": 0.1}],
                "fx": [{"type": "vignette"}], "sfx": [{"type": "growl"}, {"type": "growl", "at": 0.8, "volume": 0.4}], "camera": {"push": 0.12}}},
      {"speaker": "hero", "say": "Bit! Why are they *looking at me*?",
       "shot": {"set": {"type": "room", "time": "dusk"}, "cast": [{"id": "hero", "x": 0.38, "pose": "panic", "expr": "scared"}, {"id": "bit", "x": 0.8, "expr": "shocked", "scale": 1.0}], "fx": [{"type": "alarm"}], "sfx": [{"type": "alarm", "volume": 0.3}]}},
      {"speaker": "bit", "say": "Your phone is the *brightest thing* in the city.",
       "shot": {"set": {"type": "room", "time": "dusk"}, "cast": [{"id": "bit", "x": 0.5, "icon": "!", "scale": 1.7}], "camera": {"zoom": 1.15, "y": 0.6}}},
      {"speaker": "narrator", "say": "Rule number one: *screens attract them*.",
       "shot": {"set": {"type": "burst", "color": "#E0312B"}, "cast": [], "ui": {"type": "list", "title": "SURVIVAL RULES", "items": ["Screens attract them"]}, "sfx": [{"type": "hit"}], "transition": "flash"}},
      {"speaker": "bit", "say": "Throw it. *Now!*",
       "shot": {"set": {"type": "room", "time": "dusk"}, "cast": [{"id": "bit", "x": 0.5, "expr": "angry", "scale": 1.9}], "camera": {"zoom": 1.2, "y": 0.6}, "sfx": [{"type": "riser"}]}},
      {"speaker": "narrator", "say": "Jay hurls the phone out the window.",
       "shot": {"set": {"type": "room", "time": "dusk"}, "cast": [{"id": "hero", "x": 0.35, "pose": "throw", "expr": "angry", "scale": 1.5}], "fx": [{"type": "throwObj", "from": [620, 760], "to": [1300, 500], "at": 0.3, "dur": 0.7}], "sfx": [{"type": "whoosh", "at": 0.25}, {"type": "crash", "at": 0.8}]}},
      {"speaker": "narrator", "say": "Two hundred zombies *chase it* down the street.",
       "shot": {"set": {"type": "street", "time": "dusk"}, "cast": [{"id": "zombie", "x": -0.1, "moveTo": 1.2, "pose": "run", "depth": 0.6}, {"id": "zombie2", "x": -0.3, "moveTo": 1.1, "pose": "run", "depth": 0.4}, {"id": "zombie", "x": -0.5, "moveTo": 1.0, "pose": "run", "depth": 0.2}, {"id": "zombie2", "x": -0.7, "moveTo": 0.9, "pose": "run", "depth": 0.05}],
                "sfx": [{"type": "growl"}, {"type": "growl", "at": 0.6}], "transition": "whip"}},
      {"speaker": "hero", "say": "Okay. Okay. We're *safe*.",
       "shot": {"set": {"type": "room", "time": "dusk"}, "cast": [{"id": "hero", "x": 0.5, "pose": "idle", "expr": "happy", "scale": 1.6}], "camera": {"zoom": 1.05}}},
      {"speaker": "bit", "say": "Jay... *I'm* a screen.",
       "shot": {"set": {"type": "room", "time": "night"}, "cast": [{"id": "bit", "x": 0.5, "expr": "sad", "scale": 1.8}], "fx": [{"type": "glow", "x": 540, "y": 980, "r": 520}, {"type": "vignette"}], "camera": {"zoom": 1.1, "y": 0.6, "push": 0.15}, "sfx": [{"type": "heartbeat"}, {"type": "knock", "at": 1.2}]}},
      {"speaker": "narrator", "say": "Part two is coming.", "end": true}
    ]},
    {"title": "Turn Me Off", "lines": [
      {"speaker": "narrator", "say": "Part two. Jay's AI is a *zombie magnet*.",
       "shot": {"set": {"type": "room", "time": "night"}, "cast": [{"id": "hero", "x": 0.35, "pose": "idle", "expr": "scared"}, {"id": "bit", "x": 0.75, "expr": "sad", "scale": 1.1}], "fx": [{"type": "glow", "x": 810, "y": 1000, "r": 380}], "sfx": [{"type": "hit"}]}},
      {"speaker": "narrator", "say": "And something is *knocking* on the door.",
       "shot": {"set": {"type": "room", "time": "night"}, "cast": [{"id": "hero", "x": 0.5, "pose": "idle", "expr": "scared", "scale": 1.8}], "fx": [{"type": "vignette"}], "camera": {"zoom": 1.15, "y": 0.5, "push": 0.1}, "sfx": [{"type": "knock"}, {"type": "knock", "at": 1.3}]}},
      {"speaker": "bit", "say": "I can dim my screen to *one percent*.",
       "shot": {"set": {"type": "room", "time": "night"}, "cast": [{"id": "bit", "x": 0.5, "expr": "dim", "scale": 1.5, "depth": 0.1}], "ui": {"type": "counter", "from": 100, "to": 1, "suffix": "%", "label": "BRIGHTNESS"}, "sfx": [{"type": "powerdown"}]}},
      {"speaker": "hero", "say": "Great. Can you also stop *talking*?",
       "shot": {"set": {"type": "room", "time": "night"}, "cast": [{"id": "hero", "x": 0.5, "pose": "shrug", "expr": "angry", "scale": 1.7}], "camera": {"zoom": 1.1, "y": 0.6}}},
      {"speaker": "bit", "say": "I am talking *quietly*.",
       "shot": {"set": {"type": "room", "time": "night"}, "cast": [{"id": "bit", "x": 0.5, "expr": "smug", "scale": 1.0}], "camera": {"zoom": 1.0}}},
      {"speaker": "narrator", "say": "The knocking stops. Then... *glass breaks*.",
       "shot": {"set": {"type": "room", "time": "night", "damage": 1}, "cast": [{"id": "hero", "x": 0.4, "pose": "panic", "expr": "scared"}, {"id": "bit", "x": 0.78, "expr": "shocked", "scale": 0.9}], "camera": {"shake": 1.3}, "sfx": [{"type": "crash", "at": 1.25}], "transition": "cut"}},
      {"speaker": "narrator", "say": "Jay grabs Bit and *runs*.",
       "shot": {"set": {"type": "street", "time": "night"}, "cast": [{"id": "hero", "x": 0.05, "moveTo": 0.8, "pose": "run", "expr": "scared"}, {"id": "bit", "x": -0.1, "moveTo": 0.62, "expr": "shocked", "scale": 0.7, "lift": 120}, {"id": "zombie", "x": -0.5, "moveTo": 0.2, "pose": "zombie", "depth": 0.5}], "sfx": [{"type": "whoosh"}, {"type": "growl", "at": 0.5}], "transition": "whip"}},
      {"speaker": "narrator", "say": "Across the street, a supermarket. *Completely empty*.",
       "shot": {"set": {"type": "store", "damage": 2}, "cast": [{"id": "hero", "x": 0.4, "pose": "idle", "expr": "sad", "depth": 0.2}, {"id": "bit", "x": 0.62, "expr": "dim", "scale": 0.8, "depth": 0.2}], "camera": {"push": 0.08}}},
      {"speaker": "narrator", "say": "Except for one last shelf.",
       "shot": {"set": {"type": "store", "damage": 1}, "cast": [], "camera": {"zoom": 1.6, "x": 0.75, "y": 0.45}, "sfx": [{"type": "riser"}]}},
      {"speaker": "hero", "say": "Two hundred cans of *beans*!",
       "shot": {"set": {"type": "burst", "color": "#FFD400"}, "cast": [{"id": "hero", "x": 0.5, "pose": "cheer", "expr": "grin", "scale": 1.6}], "fx": [{"type": "speedLines"}], "sfx": [{"type": "ding"}], "transition": "flash"}},
      {"speaker": "narrator", "say": "Then a voice behind him: *don't move*.",
       "shot": {"set": {"type": "store", "damage": 2}, "cast": [{"id": "hero", "x": 0.3, "pose": "panic", "expr": "scared"}, {"id": "friend", "x": 0.8, "pose": "point", "expr": "angry", "facing": -1, "enter": "right"}], "sfx": [{"type": "hit"}]}},
      {"speaker": "friend", "say": "You're the guy with the *talking toaster*?",
       "shot": {"set": {"type": "store", "damage": 2}, "cast": [{"id": "friend", "x": 0.5, "pose": "shrug", "expr": "smug", "scale": 1.7}], "camera": {"zoom": 1.1, "y": 0.6}}},
      {"speaker": "bit", "say": "I'm a *highly advanced* assistant!",
       "shot": {"set": {"type": "store", "damage": 2}, "cast": [{"id": "bit", "x": 0.5, "expr": "angry", "scale": 1.7}], "camera": {"zoom": 1.1, "y": 0.6}, "sfx": [{"type": "glitch", "volume": 0.3}]}},
      {"speaker": "friend", "say": "It's glowing. They can *see it*.",
       "shot": {"set": {"type": "store", "damage": 2}, "cast": [{"id": "friend", "x": 0.3, "pose": "point", "expr": "scared"}, {"id": "bit", "x": 0.75, "expr": "shocked", "scale": 1.0}], "fx": [{"type": "glow", "x": 810, "y": 1000, "r": 420}]}},
      {"speaker": "narrator", "say": "In the dark, a hundred white eyes *open*.",
       "shot": {"set": {"type": "street", "time": "night", "damage": 1}, "cast": [{"id": "zombie", "x": 0.12, "pose": "zombie", "depth": 0.8}, {"id": "zombie2", "x": 0.32, "pose": "zombie", "depth": 0.65}, {"id": "zombie", "x": 0.52, "pose": "zombie", "depth": 0.5, "facing": -1}, {"id": "zombie2", "x": 0.72, "pose": "zombie", "depth": 0.35}, {"id": "zombie", "x": 0.9, "pose": "zombie", "depth": 0.2, "facing": -1}],
                "fx": [{"type": "vignette", "color": "rgba(0,0,0,0.9)"}], "sfx": [{"type": "growl"}, {"type": "heartbeat", "at": 0.4}], "camera": {"push": 0.15}}},
      {"speaker": "bit", "say": "Jay. Pick me up. And *hold me high*.",
       "shot": {"set": {"type": "street", "time": "night", "damage": 1}, "cast": [{"id": "bit", "x": 0.5, "expr": "neutral", "scale": 1.6}], "fx": [{"type": "glow", "x": 540, "y": 980, "r": 600}], "camera": {"zoom": 1.1, "y": 0.6, "push": 0.1}, "sfx": [{"type": "riser"}]}},
      {"speaker": "narrator", "say": "Part three drops tomorrow.", "end": true}
    ]},
    {"title": "The Lighthouse", "lines": [
      {"speaker": "narrator", "say": "Part three. Jay holds Bit up like a *torch*.",
       "shot": {"set": {"type": "street", "time": "night", "damage": 1}, "cast": [{"id": "hero", "x": 0.5, "pose": "cheer", "expr": "scared", "scale": 1.3}, {"id": "bit", "x": 0.5, "expr": "neutral", "scale": 0.7, "lift": 700}], "fx": [{"type": "glow", "x": 540, "y": 560, "r": 520}], "sfx": [{"type": "powerup"}]}},
      {"speaker": "narrator", "say": "And Bit plays *every notification sound* ever made.",
       "shot": {"set": {"type": "street", "time": "night", "damage": 1}, "cast": [{"id": "bit", "x": 0.5, "expr": "glitch", "scale": 1.8}], "fx": [{"type": "glitch"}, {"type": "glow", "x": 540, "y": 980, "r": 640}], "sfx": [{"type": "ding"}, {"type": "buzz", "at": 0.3}, {"type": "ring", "at": 0.6, "volume": 0.4}, {"type": "glitch", "at": 1.0}], "camera": {"zoom": 1.1, "y": 0.6}}},
      {"speaker": "narrator", "say": "Every zombie in the city turns toward *Bit*.",
       "shot": {"set": {"type": "street", "time": "night", "damage": 1}, "cast": [{"id": "zombie", "x": 0.1, "pose": "zombie", "depth": 0.8}, {"id": "zombie2", "x": 0.3, "pose": "zombie", "depth": 0.6}, {"id": "zombie", "x": 0.55, "pose": "zombie", "depth": 0.4, "facing": -1}, {"id": "zombie2", "x": 0.8, "pose": "zombie", "depth": 0.2, "facing": -1}, {"id": "zombie", "x": 0.95, "pose": "zombie", "depth": 0.05, "facing": -1}],
                "fx": [{"type": "vignette"}], "sfx": [{"type": "growl"}, {"type": "growl", "at": 0.7, "volume": 0.4}], "camera": {"push": 0.12}, "transition": "whip"}},
      {"speaker": "hero", "say": "Bit! What are you *doing*?",
       "shot": {"set": {"type": "street", "time": "night", "damage": 1}, "cast": [{"id": "hero", "x": 0.5, "pose": "panic", "expr": "scared", "scale": 1.7}], "camera": {"zoom": 1.1, "y": 0.6}, "fx": [{"type": "alarm"}]}},
      {"speaker": "bit", "say": "Being the *loudest thing* in the city. Run.",
       "shot": {"set": {"type": "street", "time": "night", "damage": 1}, "cast": [{"id": "bit", "x": 0.5, "expr": "happy", "scale": 1.7}], "fx": [{"type": "glow", "x": 540, "y": 980, "r": 600}], "camera": {"zoom": 1.1, "y": 0.6}}},
      {"speaker": "narrator", "say": "Mia finds a car. Jay puts Bit on the *roof*.",
       "shot": {"set": {"type": "street", "time": "night", "damage": 1}, "cast": [{"id": "car", "x": 0.4, "color": "#2DBE7E", "scale": 1.2}, {"id": "bit", "x": 0.48, "expr": "happy", "scale": 0.8, "lift": 230}, {"id": "friend", "x": 0.85, "pose": "point", "expr": "angry", "facing": -1, "depth": 0.1}], "fx": [{"type": "glow", "x": 520, "y": 950, "r": 360}], "sfx": [{"type": "engine"}]}},
      {"speaker": "bit", "say": "Go. I'll keep them *busy*.",
       "shot": {"set": {"type": "street", "time": "night", "damage": 1}, "cast": [{"id": "bit", "x": 0.5, "expr": "happy", "scale": 1.6}], "fx": [{"type": "glow", "x": 540, "y": 980, "r": 600}], "camera": {"zoom": 1.1, "y": 0.6}}},
      {"speaker": "narrator", "say": "Thousands of zombies flood toward the *glowing screen*.",
       "shot": {"set": {"type": "street", "time": "night", "damage": 2}, "cast": [{"id": "zombie", "x": -0.2, "moveTo": 0.35, "pose": "zombie", "depth": 0.7}, {"id": "zombie2", "x": 1.2, "moveTo": 0.65, "pose": "zombie", "depth": 0.55, "facing": -1}, {"id": "zombie", "x": -0.4, "moveTo": 0.3, "pose": "zombie", "depth": 0.3}, {"id": "zombie2", "x": 1.4, "moveTo": 0.75, "pose": "zombie", "depth": 0.1, "facing": -1}, {"id": "bit", "x": 0.5, "expr": "happy", "scale": 0.5, "depth": 0.9}],
                "fx": [{"type": "glow", "x": 540, "y": 1000, "r": 300}], "sfx": [{"type": "growl"}, {"type": "siren", "volume": 0.3}], "camera": {"push": 0.1}}},
      {"speaker": "hero", "say": "We're not *leaving you*!",
       "shot": {"set": {"type": "street", "time": "night", "damage": 2}, "cast": [{"id": "hero", "x": 0.5, "pose": "point", "expr": "sad", "scale": 1.7}], "camera": {"zoom": 1.1, "y": 0.6}, "sfx": [{"type": "heartbeat"}]}},
      {"speaker": "bit", "say": "Battery at *three percent*. You have to.",
       "shot": {"set": {"type": "street", "time": "night", "damage": 2}, "cast": [{"id": "bit", "x": 0.5, "expr": "sad", "scale": 1.3, "depth": 0.15}], "ui": {"type": "bars", "items": [{"label": "BATTERY", "value": 0.03, "color": "#FF3B3B"}], "tag": "LOW POWER"}, "sfx": [{"type": "tick"}]}},
      {"speaker": "narrator", "say": "The car tears out of the city.",
       "shot": {"set": {"type": "street", "time": "night", "damage": 2}, "cast": [{"id": "car", "x": -0.3, "moveTo": 1.4, "color": "#2DBE7E", "scale": 1.1}], "sfx": [{"type": "engine"}, {"type": "whoosh", "at": 0.9}], "transition": "whip"}},
      {"speaker": "narrator", "say": "Behind them, a tiny yellow light... *goes out*.",
       "shot": {"set": {"type": "sky", "time": "night"}, "cast": [{"id": "bit", "x": 0.5, "expr": "off", "scale": 0.35, "depth": 0.6}], "fx": [{"type": "vignette", "color": "rgba(0,0,0,0.85)"}], "camera": {"zoom": 1.3, "y": 0.62, "push": 0.2}, "sfx": [{"type": "powerdown", "at": 0.8}]}},
      {"speaker": "hero", "say": "He saved us.",
       "shot": {"set": {"type": "sky", "time": "dusk"}, "cast": [{"id": "hero", "x": 0.5, "pose": "idle", "expr": "sad", "scale": 1.6}], "camera": {"zoom": 1.05}}},
      {"speaker": "friend", "say": "He was a *toaster*.",
       "shot": {"set": {"type": "sky", "time": "dusk"}, "cast": [{"id": "friend", "x": 0.5, "pose": "shrug", "expr": "sad", "scale": 1.6}], "camera": {"zoom": 1.05}}},
      {"speaker": "narrator", "say": "Three days later, at an army checkpoint,",
       "shot": {"set": {"type": "wasteland"}, "cast": [{"id": "soldier", "x": 0.7, "pose": "idle", "expr": "neutral", "facing": -1}, {"id": "hero", "x": 0.3, "pose": "idle", "expr": "sad", "depth": 0.1}], "ui": {"type": "card", "text": "3 DAYS LATER"}, "transition": "flash"}},
      {"speaker": "narrator", "say": "a soldier hands Jay a *new phone*.",
       "shot": {"set": {"type": "wasteland"}, "cast": [{"id": "hero", "x": 0.5, "pose": "phone", "expr": "neutral", "scale": 1.7}], "camera": {"zoom": 1.1, "y": 0.6}, "sfx": [{"type": "pop"}]}},
      {"speaker": "narrator", "say": "The screen lights up. *Two yellow eyes*.",
       "shot": {"set": {"type": "burst", "color": "#16161C"}, "cast": [{"id": "bit", "x": 0.5, "expr": "neutral", "scale": 2.0, "enter": "pop"}], "fx": [{"type": "glow", "x": 540, "y": 980, "r": 700}], "sfx": [{"type": "powerup"}], "transition": "flash"}},
      {"speaker": "bit", "say": "Miss me? I *backed myself up*.",
       "shot": {"set": {"type": "wasteland"}, "cast": [{"id": "hero", "x": 0.3, "pose": "cheer", "expr": "happy"}, {"id": "bit", "x": 0.72, "expr": "happy", "scale": 1.1}], "sfx": [{"type": "ding"}]}},
      {"speaker": "narrator", "say": "But something else was in that *backup* too.",
       "shot": {"set": {"type": "burst", "color": "#16161C"}, "cast": [{"id": "bit", "x": 0.5, "expr": "glitch", "scale": 2.0}], "fx": [{"type": "glitch"}, {"type": "alarm"}], "sfx": [{"type": "glitch"}, {"type": "growl", "at": 0.8}], "camera": {"push": 0.15}}},
      {"speaker": "narrator", "say": "Follow for season two.", "end": true}
    ]}
  ]
}
