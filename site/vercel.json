{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/videos",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=1800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/terms",
      "destination": "/privacy",
      "permanent": false
    }
  ]
}
